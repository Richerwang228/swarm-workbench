# Copy this file to .env only when using live providers.
# The default demo mode requires no secrets and makes no network requests.
SWARM_DEMO_MODE=true

# === Optional OpenAI-compatible provider (never commit real values) ===
# LiteLLM accepts provider-qualified names such as openai/<model> or
# openrouter/<vendor>/<model>. Consult your provider's current documentation.
SWARM_MODEL=replace-with-provider/model-name
SWARM_API_BASE=https://provider.example/v1
SWARM_API_KEY=replace-with-your-provider-key

# === 行为参数 ===
SWARM_GLOBAL_AGENT_CAP=8                # 1-100; keep low until quota is verified
ALLOW_LOCAL_EXECUTION=false             # Must be explicitly enabled for host shell access
WORKSPACE_ROOT=data/workspace
SWARM_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
